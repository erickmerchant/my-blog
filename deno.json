{
  "unstable": ["temporal", "raw-imports", "bundle"],
  "tasks": {
    "new:post": "deno run -A cli/new-post.ts",
    "dev": "deno run -A --watch-hmr flint.ts --port=4000",
    "build": "deno run -A flint.ts --build",
    "stage": {
      "command": "deno serve -A --port=4000 --parallel dist/serve.ts",
      "dependencies": ["build"]
    },
    "fonts": "deno run -A @erickmerchant/fonts --family Figtree --weight '300 900' --fallback 'system-ui,sans-serif' && deno run -A @erickmerchant/fonts --family 'Overpass Mono' --weight 400 --style normal --fallback 'ui-monospace,monospace'  && deno run -A @erickmerchant/fonts --family Nunito --weight 800 --style normal --fallback 'Georgia,ui-serif,serif' --text 'Erick Merchant'"
  },
  "imports": {
    "@erickmerchant/fonts": "jsr:@erickmerchant/fonts@^0.8.1",
    "@erickmerchant/markdown": "jsr:@erickmerchant/markdown@^0.1.8",
    "@erickmerchant/mine-sweeper": "jsr:@erickmerchant/mine-sweeper@^1.0.6",
    "@feed/feed": "jsr:@feed/feed@^1.3.0",
    "@flint/framework": "jsr:@flint/framework@^0.41.1",
    "@handcraft/lib": "jsr:@handcraft/lib@^4.7.1",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/text": "jsr:@std/text@^1.1.0",
    "@std/toml": "jsr:@std/toml@^1.0.11"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "es2025"
    ]
  }
}
