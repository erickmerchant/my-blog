{
  "unstable": ["temporal", "bundle"],
  "tasks": {
    "new:post": "deno run -A cli/new-post.ts",
    "dev": "deno run -A --watch-hmr flint.ts --port=4000 --dev",
    "build": "deno run -A flint.ts --build",
    "stage": {
      "command": "deno serve -A --port=4000 --parallel dist/serve.ts",
      "dependencies": ["build"]
    },
    "fonts": "deno run -A @erickmerchant/fonts --config fonts.json"
  },
  "imports": {
    "@erickmerchant/fonts": "jsr:@erickmerchant/fonts@^0.9.1",
    "@erickmerchant/markdown": "jsr:@erickmerchant/markdown@^0.2.3",
    "@erickmerchant/mine-sweeper": "jsr:@erickmerchant/mine-sweeper@^2.0.2",
    "@feed/feed": "jsr:@feed/feed@^1.3.0",
    "@flint/framework": "jsr:@flint/framework@^0.43.0",
    "@handcraft/lib": "jsr:@handcraft/lib@^5.2.0",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/text": "jsr:@std/text@^1.1.0",
    "@std/toml": "jsr:@std/toml@^1.0.11"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "es2025"
    ]
  }
}
